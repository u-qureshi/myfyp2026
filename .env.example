# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Database password (Supabase → Settings → Database → Database password)
# Used by: npm run db:student-portal
SUPABASE_DB_PASSWORD=your-database-password

# Or use full connection URI instead:
# DATABASE_URL=postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-here

# CORS Configuration
CORS_ORIGINS=http://localhost:3000

# Next.js Configuration
NODE_ENV=development

# Optional: For production deployment
# CORS_ORIGINS=https://yourdomain.com

# Android app (Capacitor) — URL loaded inside the native shell
# Local phone testing: run `npm run android:dev-url` for your LAN IP
# CAPACITOR_SERVER_URL=http://192.168.1.10:3000
# Production APK: deploy web app first, then set your live URL
# CAPACITOR_SERVER_URL=https://yourdomain.com